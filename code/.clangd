CompileFlags:
    Add: 
        - -xc
        - -Wall
        - -Wextra
        - --target=aarch64-linux-gnu
        - --sysroot=../sysroot
    Compiler: clang

Diagnostics:
    ClangTidy:
        Add:
            - 'modernize*'
            - 'bugprone*'
            - 'performance*'
            - 'readability*'
            - 'linuxkernel-must-check-errs'
        Remove:
            - 'readability-identifier-length'
            - 'bugprone-easily-swappable-parameters'
            - 'readability-magic-numbers'