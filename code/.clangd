CompileFlags:
    Add: 
        - -xc
        - -Wall
        - -Wextra
        - --target=aarch64-linux-gnu
        - --sysroot=/Users/ron/Code/rfc-791/sysroot
    Compiler: gcc
    BuiltinHeaders: QueryDriver

Diagnostics:
    ClangTidy:
        Add:
            - 'modernize*'
            - 'bugprone*'
            - 'performance*'
            - 'readability*'
            - 'linuxkernel-must-check-errs'