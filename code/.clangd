CompileFlags:
    Add: 
        - '-xc'
        - '-Wall'
        - '-Wextra'
        - '-std=c99'
        - '--target=aarch64-linux-gnu'
        - '--sysroot=../sysroot'
        - '-D__UAPI_DEF_IF_IFREQ'
        - '-DIFHWADDRLEN=6'
    Compiler: clang

Diagnostics:
    ClangTidy:
        Add:
            - 'modernize*'
            - 'bugprone*'
            - 'performance*'
            - 'readability*'
            - 'linuxkernel-must-check-errs'
        Remove:
            - 'readability-identifier-length'
            - 'bugprone-easily-swappable-parameters'
            - 'readability-magic-numbers'